<%- include('../partials/admin-top') %>
<div class="login-brand"><img src="/static/img/logo/logo-full.png" alt="<%= s.agency_name %>" width="194" height="150"><small>Installation de l’espace d’administration</small></div>
<div class="a-card">
  <h1 style="font-size:1.4rem">Créer le compte propriétaire</h1>
  <p class="small">Ce compte aura un accès complet : validation et envoi des devis, tarifs, contenu du site, comptes de l’équipe. <strong>Ce lien ne fonctionne qu’une seule fois</strong> : il sera désactivé dès que le compte sera créé.</p>
  <% if (error) { %><div class="a-alert a-alert-err" role="alert"><%= error %></div><% } %>
  <form method="post" action="/admin/installation/<%= token %>" class="a-form" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="f"><label for="s-name">Nom complet</label><input id="s-name" name="name" required maxlength="120" autocomplete="name" value="<%= form.name || '' %>"></div>
    <div class="f"><label for="s-email">Adresse e-mail (identifiant de connexion)</label><input id="s-email" name="email" type="email" required maxlength="160" autocomplete="username" value="<%= form.email || '' %>"></div>
    <div class="f"><label for="s-pw">Mot de passe</label><input id="s-pw" name="password" type="password" required minlength="10" autocomplete="new-password"><p class="help">Au moins 10 caractères, avec des lettres et des chiffres.</p></div>
    <div class="f"><label for="s-pw2">Confirmer le mot de passe</label><input id="s-pw2" name="password2" type="password" required autocomplete="new-password"></div>
    <button class="a-btn" type="submit" style="width:100%">Créer mon compte</button>
  </form>
</div>
<%- include('../partials/admin-bottom') %>
