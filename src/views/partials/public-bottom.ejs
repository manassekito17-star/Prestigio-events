</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="logo logo-light"><%- include('logo') %></a>
      <p class="footer-slogan"><%= s.slogan %></p>
      <p class="muted-light">Agence événementielle — <%= s.city %></p>
    </div>
    <div>
      <h2 class="footer-h">Navigation</h2>
      <ul class="footer-links">
        <li><a href="/services"><%= h.t('nav.services') %></a></li>
        <li><a href="/offres"><%= h.t('nav.offers') %></a></li>
        <li><a href="/galerie"><%= h.t('nav.gallery') %></a></li>
        <li><a href="/a-propos"><%= h.t('nav.about') %></a></li>
        <li><a href="/devis"><%= h.t('cta.quote') %></a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Contact</h2>
      <ul class="footer-links">
        <li><a href="<%= h.waLink(s.whatsapp, 'Bonjour PRESTIGIO EVENTS, je souhaite des informations pour un événement.') %>" rel="noopener" target="_blank">WhatsApp : <%= s.phone_display %></a></li>
        <% if (s.public_email) { %><li><a href="mailto:<%= s.public_email %>"><%= s.public_email %></a></li><% } %>
        <% if (s.address) { %><li><%= s.address %></li><% } %>
      </ul>
      <% const soc = Object.entries(s.socials || {}).filter(([, v]) => v); if (soc.length) { %>
        <ul class="socials">
          <% const names = { facebook: 'Facebook', instagram: 'Instagram', tiktok: 'TikTok', linkedin: 'LinkedIn', youtube: 'YouTube' };
             for (const [k, v] of soc) { %><li><a href="<%= v %>" rel="noopener" target="_blank"><%= names[k] || k %></a></li><% } %>
        </ul>
      <% } %>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© <%= new Date().getFullYear() %> <%= s.agency_name %>. <%= h.t('footer.rights') %></p>
  </div>
</footer>
<a class="wa-float" href="<%= h.waLink(s.whatsapp, 'Bonjour PRESTIGIO EVENTS, je souhaite des informations pour un événement.') %>" target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z"/></svg>
</a>
<script src="/static/js/site.js" defer></script>
<% if (typeof scripts !== 'undefined') { for (const sc of scripts) { %><script src="<%= sc %>" defer></script><% } } %>
</body>
</html>
