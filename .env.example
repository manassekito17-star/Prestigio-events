# Copiez ce fichier en .env et complétez-le. Ne commitez jamais .env.

NODE_ENV=production
PORT=3000
# Adresse publique du site (utilisée dans les liens, le sitemap et les e-mails)
BASE_URL=https://www.votre-domaine.cd

# OBLIGATOIRE en production : longue chaîne aléatoire (ex. `openssl rand -hex 32`)
SESSION_SECRET=

# Derrière un proxy HTTPS (Nginx, Render, Railway…) : nombre de proxys de confiance
TRUST_PROXY=1

# Dossier des données (base SQLite, fichiers téléversés, sauvegardes)
# STORAGE_DIR=/var/lib/prestigio

# --- E-mail (facultatif) -------------------------------------------------
# Sans ces variables, aucun e-mail n'est envoyé : les devis validés sont
# transmis manuellement (PDF + WhatsApp) puis marqués « envoyés » à la main.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PRESTIGIO EVENTS <devis@votre-domaine.cd>"
# Adresse qui reçoit les notifications de nouvelles demandes
ADMIN_NOTIFY_EMAIL=

# Taille maximale d'un fichier téléversé (Mo)
MAX_UPLOAD_MB=25
# Nombre d'envois de formulaires publics autorisés par IP et par 15 minutes
PUBLIC_FORM_LIMIT=10
